    {
      "name": "Estudiantes /api/v1/students",
      "item": [
        {
          "name": "Crear un estudiante",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('run', Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('studentId', pm.response.json().id);",
                  "pm.test(\"Trae la cabecera Location\", function () { pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/students/'); });",
                  "pm.test(\"No expone createdAt\", function () { pm.expect(pm.response.json()).to.not.have.property('createdAt'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"age\": 22,\n  \"email\": \"ana{{run}}@mail.com\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Responde 201 con la cabecera Location. El cuerpo no trae createdAt."
          }
        },
        {
          "name": "Crear enviando campos de más (id y createdAt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('otherStudentId', pm.response.json().id);",
                  "pm.test(\"El id 99 se ignora\", function () { pm.expect(pm.response.json().id).to.not.eql(99); });",
                  "pm.test(\"No expone createdAt\", function () { pm.expect(pm.response.json()).to.not.have.property('createdAt'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 99,\n  \"name\": \"Luis Pérez\",\n  \"age\": 25,\n  \"email\": \"luis{{run}}@mail.com\",\n  \"status\": \"ACTIVE\",\n  \"createdAt\": \"2000-01-01T00:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "StudentRequest no tiene id ni createdAt: Jackson ignora lo que no existe en el record."
          }
